# ============================================================
# LLMDawg .gitignore
# ============================================================

# --- Secrets (never commit these) ---------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
*.md

# --- Python -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log

# --- Node / Next.js -----------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Docker -------------------------------------------------
# (don't ignore docker-compose overrides — they're intentional)

# --- OS / Editor --------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Alembic ------------------------------------------------
# Keep migrations in git, but ignore local SQLite if used during dev
*.db
*.sqlite3
.vercel
