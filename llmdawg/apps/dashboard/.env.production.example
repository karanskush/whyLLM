# ── Required: set all of these in Vercel → Project Settings → Environment Variables ──

# NextAuth v5
# Must match your Vercel deployment URL exactly (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app

# Generate with: openssl rand -base64 32
# In NextAuth v5 you can also use AUTH_SECRET (same value)
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# URL of your deployed FastAPI backend
# Exposed to the browser — keep it a public endpoint, no secrets here
NEXT_PUBLIC_API_URL=https://your-api.fly.dev
