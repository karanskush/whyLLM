# ============================================================
# LLMDawg — Environment Variables
# Copy this to .env and fill in real values before running.
# Never commit .env to version control.
# ============================================================

# --- Database -----------------------------------------------
# PostgreSQL DSN used by SQLAlchemy (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Port 5433 avoids collision with any local postgres running on the default 5432
DATABASE_URL=postgresql+asyncpg://llmdawg:llmdawg@localhost:5433/llmdawg

# --- Redis --------------------------------------------------
# Redis DSN. /0 is the default database index.
# Use /1 or /2 for staging/test to avoid polluting production data.
REDIS_URL=redis://localhost:6379/0

# --- Auth ---------------------------------------------------
# Secret key used for signing JWTs and encrypting session cookies.
# Must be at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-min-32-chars

# JWT access token expiry in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token expiry in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API ----------------------------------------------------
# The base URL of the FastAPI backend. Used by internal services and SDKs.
API_BASE_URL=http://localhost:8000

# API version string, returned in /health
API_VERSION=0.1.0

# Set to "development" | "staging" | "production"
ENVIRONMENT=development

# --- Dashboard (Next.js) ------------------------------------
# Public API URL — baked into Next.js bundles, accessible in browser.
# Must start with NEXT_PUBLIC_ to be exposed to the client.
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth.js base URL (must match the URL you open in the browser)
NEXTAUTH_URL=http://localhost:3000

# NextAuth.js secret — must be at least 32 random characters.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production

# --- Optional: Google OAuth (NextAuth provider) -------------
# Create credentials at https://console.cloud.google.com
# Leave empty to disable Google login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Admin --------------------------------------------------
# Comma-separated emails that can access the /admin dashboard.
# ADMIN_EMAILS=you@example.com

# --- Optional: LLM API Keys (for hallucination judge) -------
# Only needed if you enable LLM-as-judge hallucination scoring.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
